!2025/04/21 F64101066 KU TSUN YUAN Assembly Line Balancing;

MODEL:
SETS:
TASK/A B C D E F G H I J K /: t;
PRED(TASK, TASK)/
  A. B,
  B. C,
  C. D,
  A. E,
  B. F,
  C. G,
  D. H,
  E. I,
  F. J,
  G. K
/;
STATION /1..4/;
TXS(TASK, STATION): x;
ENDSETS

@FOR(TASK(i): @SUM(STATION(k): x(i, k)) = 1);
@FOR(PRED(i, j):
  @SUM(STATION(k): k * x(j, k) - k * x(i, k))>=0
);

@FOR(TXS: @BIN(x));
@FOR(STATION(k):
@SUM(TXS(i, k): T(i) * x(i, k)) <= cycletime
);

END


