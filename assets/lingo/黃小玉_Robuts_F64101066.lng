MODEL:
MAX =
(170*WW1+150*WC1+36*WB1+10*EB1-150*XW-230*XC-260*XB-238*YW1-210*YC1)/3
+(170*WW2+150*WC2+36*WB2+10*EB2-150*XW-230*XC-260*XB-238*YW2-210*YC2)/3
+(170*WW3+150*WC3+36*WB3+10*EB3-150*XW-230*XC-260*XB-238*YW3-210*YC3)/3;

!normal;
XW+XC+XB<=500;
20*XB-WB1-EB1=0;
2.5*XW-WW1+YW1=200;
3*XC-WC1+YC1=240;
!good;
XW+XC+XB<=500;
24*XB-WB2-EB2=0;
3*XW-WW2+YW2=200;
3.6*XC-WC2+YC2=240;
!bad;
XW+XC+XB<=500;
16*XB-WB3-EB3=0;
2*XW-WW3+YW3=200;
2.4*XC-WC3+YC3=240;
WB1<=6000;
WB2<=6000;
WB3<=6000;
END