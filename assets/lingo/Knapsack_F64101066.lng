!2025/04/14 F64101066 KU TSUN YUAN Knapsack_Maximizing utility of loading capacity;

SETS:
ITEMS /1..8/: WEIGHT, RATING, X;
ENDSETS

DATA:
WEIGHT = 
1 3 4 3 3 1 5 10;
RATING = 
2 9 3 8 10 6 4 10;
ENDDATA

MAX_WEIGHT = 15;
MAX = @SUM(ITEMS(I): RATING(I)*X(I));
@SUM(ITEMS(I): WEIGHT(I)*X(I)) <= MAX_WEIGHT;
@FOR(ITEMS(I): @BIN(X(I)));
