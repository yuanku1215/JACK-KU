!2025/04/21 F64101066 KU TSUN YUAN CPM_Project Management_no dummy;

MODEL:
SETS:
TASKS:TIME, ES, LS, SLASK;
PRED(TASKS, TASKS);
ENDSETS

DATA:
TASKS, TIME =
DESIGN 10
FORECAST 14
SURVEY 3
PRICE 3
SCHEDULE 7
COSTOUT 4
TRAIN 10;

PRED =
DESIGN, FORECAST,
DESIGN, SURVEY,
FORECAST, SCHEDULE,
SURVEY, PRICE,
SCHEDULE, COSTOUT,
PRICE, TRAIN,
COSTOUT, TRAIN;
ENDDATA

LTASK = @SIZE(TASKS);

@FOR(TASKS(j) | j#GT#1:
  ES(j) = @MAX(PRED(i, j): ES(i) + TIME(i))
);

@FOR(TASKS(i) | i#LT#LTASK:
  LS(i) = @MIN(PRED(i,j): LS(j) - TIME(i))
);

@FOR(TASKS(i):
  SLASK(i) = LS(i) - ES(i)
);

ES(1) = 0;
LS(LTASK) = ES(LTASK);

END