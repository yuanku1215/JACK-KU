!2025/04/21 F64101066 KU TSUN YUAN Project management_Crashing 2_@BND;

MODEL:
SETS:
TASK: NORMAL, FAST, COST, EF, ACTUAL;
PRED(TASK, TASK);
ENDSETS

DATA:
TASK, NORMAL, FAST, COST =
A 9 5 5000
B 7 3 6000
C 5 3 4000
D 8 4 2000
E 6 3 3000
F 9 5 9000;

PRED =
A, C
A, D
B, D
C, E
D, F
E, F;

DUEDATE = 22;
ENDDATA

MIN = @SUM(TASK: (NORMAL-ACTUAL) * COST);
@FOR(TASK(j): EF(j) >= ACTUAL(j));
@FOR(PRED(i, j): ED(j) >= EF(i) + ACTUAL(j));

@FOR(TASK(i):
  @BND(FAST(i), ACTUAL(i), NORMAL(i))
);

EF(@SIZE(TASK)) <= DUEDAE;
END


