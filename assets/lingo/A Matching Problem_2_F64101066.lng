! 2025/05/19 F64101066 KU TSUN YUAN A Matching Problem_2;

MODEL:
SETS:
Classmates /1..8/;
PAIRS(Classmates, Classmates) : SCORE, X;
ENDSETS

DATA:
SCORE =
0  9  3  4  2  1  5  6  
9  0  1  7  3  5  2  1  
3  1  0  4  4  2  9  2  
4  7  4  0  1  5  5  2  
2  3  4  1  0  8  7  6  
1  5  2  5  8  0  2  3  
5  2  9  5  7  2  0  4  
6  1  2  2  6  3  4  0;
ENDDATA

MIN = @SUM(PAIRS(I,J): SCORE(I,J) * X(I,J));

@FOR(Classmates(I):
    @SUM(Classmates(J) | I #NE# J: X(I,J)) +
    @SUM(Classmates(K) | I #NE# K: X(K,I)) = 1
);

@FOR(PAIRS(I,J) | I #LT# J:
    X(I,J) + X(J,I) <= 1
);

@FOR(PAIRS(I,J): @BIN(X(I,J)));

END