!2025/04/21 F64101066 KU TSUN YUAN Project Management_Crashing_Project_no obj fun;

MODEL:
SETS:
TASK/FIRST, FCAST, SURVEY, PRICE, SCHED, COSTOUT, FINAL/ :TIME, TMN, CCOST, EF, CRASM;
PRED(TASK, TASK) / 
  FIRST. FCAST,
  FIRST. SURVEY,
  FCAST. PRICE,
  SURVEY. PRICE,
  FCAST. SCHED,
  SCHED. COSTOUT,
  PRICE. FINAL,
  COSTOUT. FINAL
/;
ENDSETS

DATA:
TIME = 10 14 3 3 7 4 10;
TMIN = 10 8 2 1 6 3 8; 
CCOST = 0 4 1 2 4 5 3; 
DUEDATE = 35; 
ENDDATA

!MIN = @SUM(TASK: CCOST * CRASH);
@FOR(PRED(i, j): EF(j) >= EF(I) + TIME(j) - CRASM(j));
@FOR(TASK(j): CRASM(j) <= TIME(j) - TMIN(j));

EF(@SIZE(TASK)) <= DUEDATE;
@FOR(TASK(j): EF(j) >= TIME(j));

END