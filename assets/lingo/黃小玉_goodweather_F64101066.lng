! 2025/05/19 F64101066 KU TSUN YUAN 黃小玉_goodweather;

MODEL:

MAX = 
    1.2*170 * 2.5 * Xw + 1.2*150 * 3 * Xc + 1.2*(36 * Zb + 10 * (1 - Zb)) * 20 * Xb
    - 150 * Xw - 230 * Xc - 260 * Xb;

Xw + Xc + Xb <= 500;
2.5 * Xw >= 200;
3 * Xc >= 240;

20 * Xb <= 6000 + 10000 * (1 - Zb);


Xw >= 0;
Xc >= 0;
Xb >= 0;

@BIN(Zb);

END